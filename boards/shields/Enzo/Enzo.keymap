#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {  
    combos {
        compatible = "zmk,combos";
        
        combo_01 {
            timeout-ms = <150>; // 150 ms to press all keys
            bindings = <&kp M>; // output of the combo
            key-positions = <0 1>; // keys used in combo
            // slow-release;   //Optional Released combo only when all keys are released
            // require-prior-idle-ms; // Required time after last non-modifier key press 
        };
        
        combo_02 {
            timeout-ms = <150>;
            key-positions = <0 2>;
            bindings = <&kp D>;
        };
                
        combo_03 {
            timeout-ms = <150>;
            key-positions = <0 3>;
            bindings = <&kp C>;
        };
                
        combo_04 {
            timeout-ms = <150>;
            key-positions = <0 4>;
            bindings = <&kp U>;
        };
                
        combo_12 {
            timeout-ms = <150>;
            key-positions = <1 2>;
            bindings = <&kp R>;
        };
                
        combo_13 {
            timeout-ms = <150>;
            key-positions = <1 3>;
            bindings = <&kp H>;
        };
                
        combo_14 {
            timeout-ms = <150>;
            key-positions = <1 4>;
            bindings = <&kp L>;
        };
                
        combo_23 {
            timeout-ms = <150>;
            key-positions = <2 3>;
            bindings = <&kp I>;
        };
                
        combo_24 {
            timeout-ms = <150>;
            key-positions = <2 4>;
            bindings = <&kp N>;
        };
                
        combo_34 {
            timeout-ms = <150>;
            key-positions = <3 4>;
            bindings = <&kp S>;
        };
        
        combo_012 {
            timeout-ms = <150>;
            key-positions = <0 1 2>;
            bindings = <&kp K>;
        };
                
        combo_013 {
            timeout-ms = <150>;
            key-positions = <0 1 3>;
            bindings = <&kp X>;
        };
                
        combo_014 {
            timeout-ms = <150>;
            key-positions = <0 1 4>;
            bindings = <&kp J>;
        };
                
        combo_023 {
            timeout-ms = <150>;
            key-positions = <0 2 3>;
            bindings = <&kp Y>;
        };
                
        combo_024 {
            timeout-ms = <150>;
            key-positions = <0 2 4>;
            bindings = <&kp B>;
        };
                
        combo_034 {
            timeout-ms = <150>;
            key-positions = <0 3 4>;
            bindings = <&kp V>;
        };
                
        combo_123 {
            timeout-ms = <150>;
            key-positions = <1 2 3>;
            bindings = <&kp P>;
        };
                
        combo_124 {
            timeout-ms = <150>;
            key-positions = <1 2 4>;
            bindings = <&kp G>;
        };
                
        combo_134 {
            timeout-ms = <150>;
            key-positions = <1 3 4>;
            bindings = <&kp W>;
        };
                
        combo_234 {
            timeout-ms = <150>;
            key-positions = <2 3 4>;
            bindings = <&kp F>;
        };

        combo_0123 {
            timeout-ms = <150>;
            key-positions = <0 1 2 3>;
            bindings = <&kp BACKSPACE>;
        };
                
        combo_0124 {
            timeout-ms = <150>;
            key-positions = <0 1 2 4>;
            bindings = <&sk LSHFT>;
        };
                
//        combo_0134 {
//            timeout-ms = <150>;
//            key-positions = <0 1 3 4>;
//            bindings = <&tog TAPD>;
//        };
                
        combo_0234 {
            timeout-ms = <150>;
            key-positions = <0 2 3 4>;
            bindings = <&kp Z>;
        };
                
        combo_1234 {
            timeout-ms = <150>;
            key-positions = <1 2 3 4>;
            bindings = <&kp Q>;
        };
                
        combo_01234 {
            timeout-ms = <150>;
            key-positions = <0 1 2 3 4>;
            bindings = <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp Q         &kp W         &kp E      &kp R          &kp T            &kp Y      &kp U          &kp I      &kp O          &kp P          &kp BACKSPACE
&kp TAB           &kp A         &kp S         &kp D      &kp F          &kp G            &kp H      &kp J          &kp K      &kp L          &kp SEMI       &kp ENTER
&kp LSHIFT        &kp Z         &kp X         &kp C      &kp V          &kp B            &kp N      &kp M          &kp COMMA  &kp DOT        &kp FSLH       &none
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE  &lt ONE SPACE  &lt THREE SPACE  &kp SPACE  &lt TWO SPACE  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_WIN  &kp RIGHT_CONTROL
            >;
        };

        one {
            bindings = <
&trans  &as GRAVE   &kp RA(N2)  &as MINUS   &as NON_US_BACKSLASH  &as EQUAL  &as SINGLE_QUOTE      &as RIGHT_BRACKET  &as NON_US_HASH  &as LBKT  &kp BACKSPACE  &trans
&trans  &as N1      &as N2      &as N3      &as N4                &as N5     &as N6                &as N7             &as N8           &as N9    &as N0         &trans
&trans  &kp RA(N7)  &kp RA(N8)  &kp RA(N9)  &kp RA(N0)            &kp RA(E)  &kp RA(LEFT_BRACKET)  &kp LEFT           &kp DOWN         &kp UP    &kp RIGHT      &trans
&trans  &trans      &trans      &trans      &trans                &trans     &trans                &trans             &trans           &trans    &trans         &trans
            >;
        };

        two {
            bindings = <
&none  &none  &none  &none      &none           &none        &bt BT_NXT    &kp HOME      &kp PAGE_UP    &kp END       &bt BT_CLR    &none
&none  &none  &none  &none      &none           &none        &bt BT_PRV    &none         &kp PAGE_DOWN  &none         &sys_reset    &none
&none  &none  &none  &none      &none           &none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &none
&none  &none  &none  &soft_off  &studio_unlock  &bootloader  &trans        &trans        &trans         &none         &none         &none
            >;
        };

        three {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &kp C_NEXT  &kp C_VOL_UP  &kp KP_N7         &kp KP_N8           &kp KP_N9           &kp KP_MINUS              &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &kp C_PP    &kp C_MUTE    &mt LSHIFT KP_N4  &mt LEFT_ALT KP_N5  &mt LEFT_GUI KP_N6  &mt LEFT_CONTROL KP_PLUS  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &kp C_PREV  &kp C_VOL_DN  &kp KP_N1         &kp KP_N2           &kp KP_N3           &kp KP_MULTIPLY           &none
&none  &none   &none    &trans   &trans   &trans      &trans        &kp KP_DOT        &kp KP_N0           &none               &none                     &none
            >;
        };
    };
 };
